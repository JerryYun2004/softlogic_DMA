SHELL := /bin/bash

THIS_MAKEFILE := $(lastword $(MAKEFILE_LIST))
TEST_DIR      := $(patsubst %/,%,$(dir $(abspath $(THIS_MAKEFILE))))
REPO_ROOT     := $(abspath $(TEST_DIR)/../..)
RTL_DIR       := $(REPO_ROOT)/user_design/gemm_dma
NPU_DIR 	  ?= $(REPO_ROOT)/user_design/npu
BUILD_DIR     := $(TEST_DIR)/build

IVERILOG ?= iverilog
VVP       ?= vvp

DMA_SOURCES := \
	$(RTL_DIR)/gemm_tile_dma_agu.sv \
	$(RTL_DIR)/gemm_dma_axi_wrapper.sv

NPU_SOURCES := \
	$(NPU_DIR)/pe.sv \
	$(NPU_DIR)/systolic_array.sv \
	$(NPU_DIR)/npu_crossbar.sv \
	$(NPU_DIR)/npu_top.sv \
	$(NPU_DIR)/sram_bank.sv \
	$(NPU_DIR)/npu_sram_wrapper.sv

UNIT_TB       := $(TEST_DIR)/tb_gemm_dma_unit.sv
INTEGRATED_TB := $(TEST_DIR)/tb_npu_gemm_dma_integrated.sv

.PHONY: all unit integrated clean help

all: unit integrated

$(BUILD_DIR):
	mkdir -p "$@"

unit: $(BUILD_DIR)
	$(IVERILOG) -g2012 -Wall -s tb_gemm_dma_unit \
		-o "$(BUILD_DIR)/tb_gemm_dma_unit.vvp" \
		$(DMA_SOURCES) $(UNIT_TB)
	$(VVP) "$(BUILD_DIR)/tb_gemm_dma_unit.vvp"

integrated: $(BUILD_DIR)
	@for source in $(NPU_SOURCES); do \
		if [[ ! -f "$$source" ]]; then \
			echo "Missing NPU RTL: $$source"; \
			echo "Override NPU_DIR=/path/to/the/directory if needed."; \
			exit 1; \
		fi; \
	done
	$(IVERILOG) -g2012 -Wall -s tb_npu_gemm_dma_integrated \
		-o "$(BUILD_DIR)/tb_npu_gemm_dma_integrated.vvp" \
		$(DMA_SOURCES) $(NPU_SOURCES) $(INTEGRATED_TB)
	$(VVP) "$(BUILD_DIR)/tb_npu_gemm_dma_integrated.vvp"

clean:
	rm -rf -- "$(BUILD_DIR)"

help:
	@echo "make -f Test/gemm_dma/Makefile.gemm_dma unit"
	@echo "make -f Test/gemm_dma/Makefile.gemm_dma integrated"
	@echo "make -f Test/gemm_dma/Makefile.gemm_dma all"
	@echo "Optional: NPU_DIR=/absolute/path/to/user_design"

