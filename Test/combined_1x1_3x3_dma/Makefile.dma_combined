SHELL := /bin/bash

MAKEFILE_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
REPO_ROOT ?= $(abspath $(MAKEFILE_DIR)/../..)
RTL_DIR ?= $(REPO_ROOT)/user_design/combined_1x1_3x3_dma
TEST_DIR ?= $(REPO_ROOT)/Test/combined_1x1_3x3_dma
BUILD_DIR ?= $(REPO_ROOT)/Test/build/combined_1x1_3x3_dma

IVERILOG ?= iverilog
VVP ?= vvp
PYTHON ?= python3

RTL_SRCS := \
	$(RTL_DIR)/combined_hwc_channel_dma_agu.sv \
	$(RTL_DIR)/dma_axil_control.v \
	$(RTL_DIR)/dma_axi_burst_planner.v \
	$(RTL_DIR)/dma_map_datapath.v \
	$(RTL_DIR)/dma_fetch_engine.v \
	$(RTL_DIR)/dma_a.v \
	$(RTL_DIR)/dma_npu_sram_adapter.sv

NPU_INTEGRATION_SRC := $(RTL_DIR)/combined_dma_npu_sram_top.sv

UNIT_TB := $(TEST_DIR)/tb_combined_dma.sv
MODEL_CHECK := $(TEST_DIR)/check_reference_schedules.py
MUX_LEGALITY_CHECK := $(TEST_DIR)/check_fabulous_mux_usage.py

# The FABulous flow normally writes this JSON before nextpnr. Override with
# `SYNTH_JSON=/path/to/design.json` if the platform uses a different name.
SYNTH_JSON ?= $(RTL_DIR)/combined_hwc_channel_dma_agu.json
SYNTH_TOP ?= top_wrapper

NPU_RTL_DIR ?= $(REPO_ROOT)/user_design/npu
NPU_SRCS ?= \
	$(NPU_RTL_DIR)/pe.sv \
	$(NPU_RTL_DIR)/systolic_array.sv \
	$(NPU_RTL_DIR)/npu_crossbar.sv \
	$(NPU_RTL_DIR)/npu_top.sv \
	$(NPU_RTL_DIR)/sram_bank.sv \
	$(NPU_RTL_DIR)/npu_sram_wrapper.sv

# The integrated verification vectors live beside this Makefile and the
# testbenches. Deriving both roots from TEST_DIR keeps these paths valid when
# the repository is cloned or moved, while still allowing command-line
# overrides such as `CONV1_MEM_DIR=/path/to/vectors`.
CONV1_MEM_DIR ?= $(TEST_DIR)
CONV3_MEM_DIR ?= $(TEST_DIR)
CONV1_IMAGE_MEM ?= $(CONV1_MEM_DIR)/yolo_conv1_in.mem
CONV1_WEIGHTS_MEM ?= $(CONV1_MEM_DIR)/yolo_conv1_w.mem
CONV1_GOLDEN_MEM ?= $(CONV1_MEM_DIR)/golden_conv1.mem
CONV3_IMAGE_MEM ?= $(CONV3_MEM_DIR)/yolo_image_3x3.mem
CONV3_WEIGHTS_MEM ?= $(CONV3_MEM_DIR)/yolo_weights_3x3.mem
CONV3_GOLDEN_MEM ?= $(CONV3_MEM_DIR)/golden_conv3.mem

UNIT_VVP := $(BUILD_DIR)/tb_combined_dma.vvp
SEQ_VVP := $(BUILD_DIR)/tb_npu_yolo_combined_sequential_integrated.vvp

.PHONY: all check packed-check ownership-check pnr-mux-check mux-usage sim unit model integrated integrated-sequential \
	check-tools check-npu-files check-conv1-mem check-conv3-mem clean help

all: check

check: model unit

# Descriptive alias for CI jobs that specifically exercise the packed-source
# long-burst revision.
packed-check: check

# The standalone RTL regression now instantiates the synthesizable NPU SRAM
# adapter and deliberately removes grants/asserts array_active to verify that
# map_ready and every physical write/shift enable are ownership-qualified.
ownership-check: unit

sim: unit

unit: check-tools $(UNIT_VVP)
	@echo "Running packed AXI burst and NPU SRAM ownership regression"
	$(VVP) $(UNIT_VVP)

model:
	@echo "Checking packed descriptors, direct 32-bit steering, and AXI read plan"
	$(PYTHON) $(MODEL_CHECK)

# Run this after the platform Yosys step. This baseline intentionally contains
# no manually forced FABULOUS_MUX2/4/8 cells. On this fabric those are LUT
# cascade resources, and nextpnr rejects one whose data input is register- or
# I/O-driven. Architecture-aware synthesis may introduce legal cascades later.
pnr-mux-check:
	@test -f "$(SYNTH_JSON)" || { \
		echo "ERROR: synthesized JSON not found: $(SYNTH_JSON)"; \
		echo "Run the Yosys/compile-json step first or set SYNTH_JSON=..."; \
		exit 1; \
	}
	$(PYTHON) $(MUX_LEGALITY_CHECK) "$(SYNTH_JSON)" --top "$(SYNTH_TOP)" \
		--max-mux2 0 --max-mux4 0 --max-mux8 0

# Backward-compatible name for the command used by the previous package.
mux-usage: pnr-mux-check

integrated: integrated-sequential

integrated-sequential: check-tools check-npu-files check-conv1-mem \
	check-conv3-mem $(SEQ_VVP)
	$(VVP) $(SEQ_VVP) \
		+CONV3_IMAGE_MEM=$(abspath $(CONV3_IMAGE_MEM)) \
		+CONV3_WEIGHTS_MEM=$(abspath $(CONV3_WEIGHTS_MEM)) \
		+CONV3_GOLDEN_MEM=$(abspath $(CONV3_GOLDEN_MEM)) \
		+CONV1_IMAGE_MEM=$(abspath $(CONV1_IMAGE_MEM)) \
		+CONV1_WEIGHTS_MEM=$(abspath $(CONV1_WEIGHTS_MEM)) \
		+CONV1_GOLDEN_MEM=$(abspath $(CONV1_GOLDEN_MEM))

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(UNIT_VVP): $(RTL_SRCS) $(UNIT_TB) | $(BUILD_DIR)
	$(IVERILOG) -g2012 -Wall -s tb_combined_dma \
		-o $@ $(RTL_SRCS) $(UNIT_TB)

$(SEQ_VVP): $(RTL_SRCS) $(NPU_INTEGRATION_SRC) $(NPU_SRCS) \
	$(TEST_DIR)/tb_npu_yolo_combined_sequential_integrated.sv | $(BUILD_DIR)
	$(IVERILOG) -g2012 -Wall \
		-s tb_npu_yolo_combined_sequential_integrated \
		-o $@ $(RTL_SRCS) $(NPU_INTEGRATION_SRC) $(NPU_SRCS) \
		$(TEST_DIR)/tb_npu_yolo_combined_sequential_integrated.sv

check-tools:
	@command -v $(IVERILOG) >/dev/null || { \
		echo "ERROR: iverilog was not found in PATH"; exit 1; }
	@command -v $(VVP) >/dev/null || { \
		echo "ERROR: vvp was not found in PATH"; exit 1; }

check-npu-files:
	@for source in $(NPU_SRCS); do \
		test -f "$$source" || { \
			echo "ERROR: missing NPU RTL: $$source"; exit 1; }; \
	done

check-conv1-mem:
	@for memory in $(CONV1_IMAGE_MEM) $(CONV1_WEIGHTS_MEM) $(CONV1_GOLDEN_MEM); do \
		test -f "$$memory" || { \
			echo "ERROR: missing 1x1 memory file: $$memory"; exit 1; }; \
	done

check-conv3-mem:
	@for memory in $(CONV3_IMAGE_MEM) $(CONV3_WEIGHTS_MEM) $(CONV3_GOLDEN_MEM); do \
		test -f "$$memory" || { \
			echo "ERROR: missing 3x3 memory file: $$memory"; exit 1; }; \
	done

clean:
	@test -n "$(BUILD_DIR)" && test "$(BUILD_DIR)" != "/"
	rm -rf -- $(BUILD_DIR)

help:
	@echo "make -f Test/combined_1x1_3x3_dma/Makefile.dma_combined check"
	@echo "make -f Test/combined_1x1_3x3_dma/Makefile.dma_combined packed-check"
	@echo "make -f Test/combined_1x1_3x3_dma/Makefile.dma_combined ownership-check"
	@echo "make -f Test/combined_1x1_3x3_dma/Makefile.dma_combined pnr-mux-check SYNTH_JSON=path/to/design.json"
	@echo "make -f Test/combined_1x1_3x3_dma/Makefile.dma_combined unit"
	@echo "make -f Test/combined_1x1_3x3_dma/Makefile.dma_combined model"
	@echo "make -f Test/combined_1x1_3x3_dma/Makefile.dma_combined integrated"
	@echo "make -f Test/combined_1x1_3x3_dma/Makefile.dma_combined integrated-sequential"
